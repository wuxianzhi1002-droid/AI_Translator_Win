{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 翻译工具",
  "version": "0.1.0",
  "identifier": "AI.Translator.Windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AI 翻译工具",
      "width": 980,
      "height": 560,
      "minWidth": 820,
      "minHeight": 430,
      "center": true,
      "visible": false,
      "decorations": true,
      "transparent": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
